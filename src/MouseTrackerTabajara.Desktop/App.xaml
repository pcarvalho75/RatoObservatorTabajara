<Application x:Class="MouseTrackerTabajara.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#143E59"/><SolidColorBrush x:Key="Water" Color="#176A96"/>
    <SolidColorBrush x:Key="Mist" Color="#F3F7FA"/><SolidColorBrush x:Key="Line" Color="#D3E0E8"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#B7CDDC"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,4,10,10"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,10,5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  </Application.Resources>
</Application>
