<Window x:Class="MouseTrackerTabajara.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MouseTrackerTabajara.Desktop"
  Title="Mouse Tracker Tabajara — Native WPF workspace" Width="1440" Height="960" MinWidth="1050" MinHeight="700" Background="{StaticResource Mist}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13">
  <Grid x:Name="RootGrid" Background="{StaticResource Mist}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="BrandSidebar" Background="{StaticResource Ink}" Padding="16,24"><DockPanel>
      <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="Local processing" Foreground="#8DE0C3"/><TextBlock Text="Original videos remain unchanged.&#10;Coverage is not accuracy." Foreground="#BBD4E3" FontSize="11" Margin="0,10,0,12" TextWrapping="Wrap"/><TextBlock x:Name="RoadmapScore" Foreground="White" FontSize="19"/><TextBlock Text="Accepted roadmap points" Foreground="#BBD4E3" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="{Binding StudyFileLabel}" TextWrapping="Wrap" Foreground="#BBD4E3" FontSize="10" Margin="0,14,0,0"/><TextBlock Text="{Binding StudyNote}" TextWrapping="Wrap" Foreground="#8DE0C3" FontSize="10" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="WPF · .NET 10 · OpenCV 5" Foreground="#BBD4E3" FontSize="10" Margin="0,16,0,0"/></StackPanel>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="ProductWordmark" Text="Mouse Tracker Tabajara" FontFamily="Bahnschrift" FontSize="22" Foreground="White" TextWrapping="Wrap" TextTrimming="None" LineHeight="26"/>
        <ScrollViewer x:Name="SidebarActionsScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style></StackPanel.Resources><TextBlock Text="Native Windows workspace" Foreground="#BBD4E3" FontSize="11" Margin="0,0,0,28"/>
          <TextBlock Text="Video review" Foreground="White" FontSize="17"/><TextBlock Text="One animal at a time.&#10;One experiment together." Foreground="#BBD4E3" Margin="0,12,0,28" TextWrapping="Wrap"/>
          <CheckBox x:Name="BlindReview" Content="Blind review" Foreground="White" Checked="BlindChanged" Unchecked="BlindChanged" ToolTip="Hide group labels, filenames, and animal IDs. Unblinding stores a reviewer and a reason. The video picture is not redacted." AutomationProperties.Name="Blind review. Software labels only. Video pixels are not redacted."/>
          <Button x:Name="UpdatesButton" Content="Updates" Click="OpenUpdates" Margin="0,5,0,0"/>
          <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="#8DE0C3" FontSize="11" Margin="0,6,0,6"/>
          <Button Content="Detailed roadmap" Click="OpenRoadmap" Margin="0,5,0,0"/>
          <Button Content="Study atlas" Click="OpenStudyAtlas" Margin="0,5,0,0"/>
          <Button Content="Result stability" Click="OpenResultStability" Margin="0,5,0,0"/>
          <Button Content="Experiment plan and maps" Click="OpenExperiment" Margin="0,5,0,0"/>
          <Button x:Name="CameraSetupButton" Content="Camera setup" Click="OpenCameraSetup" IsEnabled="{Binding NotBusy}" Margin="0,5,0,0"/>
          <Button Content="Independent reference validation" Click="OpenIndependentValidation" Margin="0,5,0,0"/>
          <Button Content="Detector sensitivity" Click="OpenSensitivity" Margin="0,5,0,0"/>
          <Button x:Name="RegionScenarioButton" ContentTemplate="{x:Null}" Click="OpenRegionScenarios" Margin="0,5,0,0" HorizontalContentAlignment="Left"><TextBlock Text="Region and calibration scenarios" TextWrapping="Wrap"/></Button>
          <Button Content="Whole-study report" Click="OpenStudyReport" Margin="0,5,0,0"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="26,8,26,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="*" MinHeight="64" MaxHeight="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,8"><WrapPanel Margin="0,0,0,6"><Button x:Name="NewProjectButton" Content="New project" Click="NewProject" IsEnabled="{Binding NotBusy}"/><Button x:Name="OpenProjectButton" Content="Open project" Click="OpenProject" IsEnabled="{Binding NotBusy}"/><Button x:Name="SaveProjectButton" Content="Save processed project" Click="SaveProcessedProject" IsEnabled="{Binding NotBusy}"/><Button x:Name="StudyIntakeButton" Content="Bulk intake" Click="OpenStudyIntake" IsEnabled="{Binding NotBusy}" ToolTip="Bulk study intake: preview and reconcile a CSV manifest of trial videos against the expected plan. Nothing is confirmed automatically." AutomationProperties.Name="Bulk study intake from a CSV manifest"/><TextBlock Text="Changes autosave; snapshots preserve completed clips." FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="StudyTitle" Text="Luciana’s Morris water maze" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Inventory}" Foreground="#5B7180" Margin="0,6,0,0"/></StackPanel><WrapPanel x:Name="CommandBar" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ImportButton" Content="Add videos" Click="ImportVideos" IsEnabled="{Binding NotBusy}"/><Button Content="Analyze selected" Click="AnalyzeSelected" IsEnabled="{Binding NotBusy}"/><Button Content="Analyze all" Background="{StaticResource Water}" Foreground="White" Click="AnalyzeAll" IsEnabled="{Binding NotBusy}"/><Button Content="Cancel" Click="CancelBatch" IsEnabled="{Binding Busy}"/>
      </WrapPanel></DockPanel></StackPanel>
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,6" Padding="0,6,0,0"><DockPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" DockPanel.Dock="Left" MaxWidth="860"/><ProgressBar Width="180" Height="8" Maximum="100" Value="{Binding Progress}" HorizontalAlignment="Right"/></DockPanel></Border>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="305"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,4"><TextBlock x:Name="SelectedTitle" Text="Choose a recording" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="FullTrajectory" Content="Full trajectory" IsChecked="True" Checked="ViewChanged" Unchecked="ViewChanged" HorizontalAlignment="Right"/></DockPanel>
          <Border x:Name="ViewerViewport" Grid.Row="1" Background="#073F64" CornerRadius="7" ClipToBounds="True" MouseLeftButtonDown="OverlayClicked"><Viewbox Stretch="Uniform"><Grid x:Name="FramePlane" Width="1920" Height="1080"><Image x:Name="FrameImage" Stretch="Fill"/><Canvas x:Name="FrameOverlay" Background="Transparent"/></Grid></Viewbox></Border>
          <DockPanel Grid.Row="2" Margin="0,4,0,4"><Button x:Name="PlayButton" Content="▶" Click="PlayPause" Width="38"/><Button Content="‹" Click="PreviousFrame" Width="30"/><Button Content="›" Click="NextFrame" Width="30"/><TextBlock x:Name="FrameClock" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/><Slider x:Name="FrameSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FrameChanged" VerticalAlignment="Center"/></DockPanel>
          <WrapPanel x:Name="ViewerTools" Grid.Row="3"><Button Content="Set pool" Click="SetPool" IsEnabled="{Binding NotBusy}"/><Button Content="Set platform" Click="SetPlatform" IsEnabled="{Binding NotBusy}"/><Button x:Name="CorrectPointButton" Content="Correct point" Click="SetCorrection"/><Button x:Name="MarkUnknownButton" Content="Mark unknown" Click="MarkUnknown"/><Button Content="Export this run" Click="ExportRun" IsEnabled="{Binding NotBusy}"/><CheckBox x:Name="BinaryView" Content="Detection mask" Checked="BinaryChanged" Unchecked="BinaryChanged"/></WrapPanel>
          <TextBlock Grid.Row="4" x:Name="ContractLabel" Text="Editable preview. No analyzed run yet." Foreground="#8A4B12" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Margin="2,2,0,0"/>
          <TextBlock Grid.Row="5" x:Name="ViewerHint" Text="Inspect positions against the recording before confirming review." Foreground="#5B7180" TextWrapping="Wrap" FontSize="11" Margin="2,2,0,4"/>
        </Grid>
        <Border Grid.Column="1" Background="White" CornerRadius="7" Padding="20,16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Tracking quality" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="CoverageValue" Text="—" FontSize="32" FontFamily="Bahnschrift" Margin="0,6,0,0"/><TextBlock x:Name="CoverageCaption" Text="Accepted detections, not validated accuracy" Foreground="#5B7180" FontSize="10" TextWrapping="Wrap"/>
          <TextBlock x:Name="MetricsReadout" Text="Analyze a recording to inspect measurements." Margin="0,10,0,8" TextWrapping="Wrap" LineHeight="20"/>
          <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"><TextBlock x:Name="CollectionCompatibilityReadout" TextWrapping="Wrap" FontSize="11"/></ScrollViewer>
          <Separator Margin="0,0,0,12"/><TextBlock Text="Detector and trial settings" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <UniformGrid Columns="2" IsEnabled="{Binding NotBusy}"><StackPanel><TextBlock Text="Threshold" FontSize="11"/><TextBox x:Name="ThresholdInput" Text="30"/></StackPanel><StackPanel><TextBlock Text="Blur" FontSize="11"/><TextBox x:Name="BlurInput" Text="2"/></StackPanel><StackPanel><TextBlock Text="Min area (px²)" FontSize="11"/><TextBox x:Name="MinAreaInput" Text="100"/></StackPanel><StackPanel><TextBlock Text="Max area (px²)" FontSize="11"/><TextBox x:Name="MaxAreaInput" Text="6000"/></StackPanel><StackPanel><TextBlock Text="Max step (px)" FontSize="11"/><TextBox x:Name="MaxJumpInput" Text="50"/></StackPanel><StackPanel><TextBlock Text="Diameter (cm)" FontSize="11"/><TextBox x:Name="DiameterInput"/></StackPanel><StackPanel><TextBlock Text="Start (s)" FontSize="11"/><TextBox x:Name="StartInput" Text="0"/></StackPanel><StackPanel><TextBlock Text="End (s)" FontSize="11"/><TextBox x:Name="EndInput"/></StackPanel></UniformGrid>
          <CheckBox x:Name="InvertInput" Content="Detect dark animals" IsChecked="True" IsEnabled="{Binding NotBusy}"/><CheckBox x:Name="ArenaConfirmedInput" Content="Pool boundary confirmed" IsEnabled="{Binding NotBusy}"/>
          <TextBlock Text="Platform-site horizontal width (source pixels)" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Horizontal source-pixel width of the measured site ellipse. Vertical extent follows the pool axes." FontSize="10" Foreground="#5B7180" TextWrapping="Wrap"/><TextBox x:Name="SiteDiameterInput" Text="80" IsEnabled="{Binding NotBusy}"/>
          <Button Content="Save settings" Click="SaveSettings" IsEnabled="{Binding NotBusy}"/><Button Content="Confirm tracking review" Click="ConfirmReview" IsEnabled="{Binding NotBusy}"/>
          <TextBlock Text="Annotation reason" FontSize="11" Margin="0,12,0,0"/><TextBox x:Name="AnnotationReasonInput" IsEnabled="{Binding NotBusy}"/>
          <TextBlock Text="Reviewer" FontSize="11"/><TextBox x:Name="ReviewerInput" IsEnabled="{Binding NotBusy}"/>
          <TextBlock Text="Planned exposure (s)" FontSize="11"/><TextBox x:Name="PlannedExposureInput" IsEnabled="{Binding NotBusy}"/>
          <CheckBox x:Name="ReleaseConfirmedInput" Content="Release anchor confirmed" IsEnabled="{Binding NotBusy}" ToolTip="Confirms the stored release anchor. Seeking does not move it." AutomationProperties.Name="Release anchor confirmed"/>
          <CheckBox x:Name="WindowConfirmedInput" Content="Planned window confirmed" IsEnabled="{Binding NotBusy}"/>
          <Button x:Name="UseDisplayedReleaseButton" Content="Use displayed frame as release" Click="UseDisplayedFrameAsRelease" ToolTip="Sets the release anchor from the completed displayed frame. The viewer position is not used while saving a duration." AutomationProperties.Name="Use the completed displayed frame as the release anchor"/>
          <TextBlock x:Name="ReleaseAnchorReadout" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,4" Text="No release anchor. The viewer frame is not the release."/>
          <WrapPanel><Button x:Name="WaterEntryButton" Content="Water entry" Click="RecordWaterEntry"/><Button x:Name="MountingButton" Content="Mounting" Click="RecordMounting"/><Button x:Name="InterventionButton" Content="Intervention" Click="RecordIntervention"/><Button x:Name="RecordingEndButton" Content="Recording end" Click="RecordRecordingEnd"/><Button x:Name="ReviseEventButton" Content="Revise latest" Click="ReviseLatestEvent"/><Button x:Name="SaveProtocolButton" Content="Save protocol" Click="SaveProtocol"/></WrapPanel>
          <TextBlock x:Name="EventReadout" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,4"/><TextBlock x:Name="ProtocolReadout" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
          <TextBlock x:Name="InclusionReadout" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,4" Text="Inclusion is separate from tracking review and from measurement eligibility."/>
          <WrapPanel><Button x:Name="ExcludeRecordingButton" Content="Exclude recording" Click="ExcludeRecording" ToolTip="Records an exclusion with a reason. The recording stays in the inventory and the planned window is unchanged." AutomationProperties.Name="Exclude this recording with a reason"/><Button x:Name="IncludeRecordingButton" Content="Include recording" Click="IncludeRecording" ToolTip="Records a reasoned inclusion. This does not approve tracking accuracy or change the planned window." AutomationProperties.Name="Include this recording with a reason"/><Button x:Name="ExportBlindReviewButton" Content="Export blinded review" Click="ExportBlindReview" ToolTip="Writes an allowlisted review file. Source names, animal IDs, groups, and source hashes are omitted." AutomationProperties.Name="Export the blinded review projection"/></WrapPanel>
          <TextBlock x:Name="BlindPixelNote" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,4" Visibility="Collapsed" Text="Blind review hides software labels, file names, animal IDs, and groups. The video picture is not redacted and may still show identifying text."/>
          <Button x:Name="AttestInspectionButton" Content="Attest inspected moment" Click="AttestInspection" Margin="0,8,0,0" ToolTip="Records an inspection only after the source frame is displayed. Choosing a moment only navigates." AutomationProperties.Name="Attest the completed displayed source frame"/>
          <TextBlock Text="Review moments" FontWeight="SemiBold" Margin="0,12,0,7"/><ItemsControl x:Name="ReviewMomentList" ItemsSource="{Binding ReviewMoments}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="JumpToReview" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Reason}"><StackPanel><TextBlock Text="{Binding Reason}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding StartFrame,StringFormat=Frame {0}}" FontSize="10" Foreground="#5B7180"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer></Border>
      </Grid>
      <DataGrid Grid.Row="3" x:Name="TrialGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="{Binding Busy}" SelectionMode="Single" SelectionChanged="TrialSelected" CellEditEnding="MetadataEdited" Margin="0,4,0,2" Background="White" BorderBrush="{StaticResource Line}" GridLinesVisibility="Horizontal" RowHeight="32" HeadersVisibility="Column">
        <DataGrid.Columns><DataGridTextColumn Header="Recording" Binding="{Binding DisplayName}" IsReadOnly="True" Width="220"/><DataGridTextColumn Header="Animal" Binding="{Binding AnimalDisplay,UpdateSourceTrigger=PropertyChanged}" Width="160"/><DataGridCheckBoxColumn Header="ID confirmed" Binding="{Binding AnimalIdConfirmed}" Width="90"/><DataGridTextColumn Header="Group" Binding="{Binding GroupDisplay,UpdateSourceTrigger=PropertyChanged}" Width="150"/><DataGridComboBoxColumn Header="Trial type" ItemsSource="{x:Static local:MainViewModel.TrialModes}" SelectedItemBinding="{Binding Phase,UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Day" Binding="{Binding Day,UpdateSourceTrigger=PropertyChanged}" Width="45"/><DataGridTextColumn Header="Trial" Binding="{Binding Trial,UpdateSourceTrigger=PropertyChanged}" Width="45"/><DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Review" Binding="{Binding Status}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="Inclusion" Binding="{Binding Inclusion}" IsReadOnly="True" Width="90"/></DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="4" x:Name="WorkspaceFooter" Text="Native development build. Group claims await confirmed experimental design and held-out validation. Platform-site entry does not confirm mounting." FontSize="10" Foreground="#5B7180" Margin="0,2,0,0" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Window>
